rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profiles. Admin-created accounts come from the createEmployee Cloud
    // Function (Admin SDK bypasses these rules). Self-registration from the
    // sign-up screen is allowed, but ONLY for the caller's own document and ONLY
    // as an employee — that clause is what stops anyone making themselves admin.
    // Only an admin can edit a profile afterwards, so role can't be changed later.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'employee'
        && request.resource.data.active == true
        && request.resource.data.assignedVehicleId == '';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Vehicles: everyone signed in can see fleet info, only admin edits it.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Time logs: an employee can create/update only their own log, and read
    // only their own; admin can read everything.
    match /timeLogs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Fuel logs: same pattern as time logs.
    match /fuelLogs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Single settings document used by the app + Cloud Functions.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
