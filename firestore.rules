rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profiles. Admin-created accounts come from the createEmployee Cloud
    // Function (Admin SDK bypasses these rules). Self-registration from the
    // sign-up screen is allowed, but ONLY for the caller's own document and ONLY
    // as an employee — that clause is what stops anyone making themselves admin.
    // Only an admin can edit a profile afterwards, so role can't be changed later.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.role == 'employee'
        && request.resource.data.active == true
        && request.resource.data.assignedVehicleId == '';
      allow update: if isAdmin();
      // Admins can delete a profile — needed to clear duplicate sign-ups. This only
      // removes the Firestore record; the person's Firebase Auth login still exists
      // but becomes unusable, since the app refuses a login with no profile.
      allow delete: if isAdmin();
    }

    // Reserves an employee number so two people can't sign up with the same one.
    //
    // A signing-up user cannot read the users collection (that would leak staff
    // details), so uniqueness can't be checked with a query. Instead they claim a
    // document named after the number. "create" only succeeds when the document
    // doesn't exist, and update is forbidden, so a second claim fails outright —
    // which also makes it race-proof, unlike a read-then-write check.
    match /employeeNumbers/{employeeNumber} {
      allow get: if isSignedIn();
      // Signing-up users may only claim a number for themselves. Admins may claim on
      // someone else's behalf, which is needed when correcting an employee's number.
      allow create: if isSignedIn() &&
        (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
      // The holder can release their own claim. Needed when a sign-up fails partway:
      // without this the number stays reserved to an account that no longer exists,
      // and nobody could ever register it again.
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // The authoritative staff list the admin uploads, keyed by employee number.
    // Admin-only: it holds names and postings for people who may not have signed up
    // yet, so there's no reason for an employee's app to read it.
    match /roster/{employeeNumber} {
      allow read, write: if isAdmin();
    }

    // Vehicles: everyone signed in can see fleet info, only admin edits it.
    // Vehicles are the admin's to create, edit and delete. The one exception is the
    // odometer, and it has to be an exception.
    //
    // The app calls updateVehicleOdometer() on every clock in and clock out, so the
    // reading a driver types keeps the vehicle current and the service countdown
    // honest. Under an admin-only write rule that call was denied every time, so
    // currentOdometerKm only ever moved when an admin edited a vehicle by hand — and
    // "km to next service" was measured from a reading that could be months old, on
    // the driver's phone and in the portal alike.
    //
    // So: a signed-in driver may update ONE field, on ONE vehicle — the one assigned to
    // them — and only ever upwards. An odometer does not run backwards, and a reading
    // that would lower it is a typo or a different vehicle, neither of which should be
    // written. Everything else about a vehicle stays admin-only.
    function advancesOwnOdometer(vehicleId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.assignedVehicleId == vehicleId
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['currentOdometerKm'])
        && request.resource.data.currentOdometerKm is int
        && request.resource.data.currentOdometerKm > resource.data.currentOdometerKm;
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || advancesOwnOdometer(vehicleId);
    }

    // Time logs: an employee can create/update and read only their own; admin can
    // read everything.
    //
    // "get" is split from "list" on purpose. The app reads timeLogs/{uid}_{date}
    // directly, and before someone clocks in that document does not exist yet —
    // for a missing document `resource` is null, so `resource.data.uid` would
    // error and deny the read. The `resource == null` check below is what lets an
    // employee open the app before clocking in. Listing stays admin-only, since
    // only the dashboard queries across everyone.
    match /timeLogs/{logId} {
      allow get: if isAdmin() ||
        (isSignedIn() && (resource == null || resource.data.uid == request.auth.uid));
      // Employees may list their OWN days, which is what the "my recent days" screen
      // needs. Firestore only permits a query it can prove satisfies this rule, so a
      // client asking for everyone's logs is rejected outright.
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      // Admins can create on someone's behalf, so a forgotten day can be recorded
      // after the fact. Employees can still only create their own.
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Fuel logs: same pattern as time logs.
    match /fuelLogs/{logId} {
      allow get: if isAdmin() ||
        (isSignedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Performance figures, uploaded by an admin from a spreadsheet. They split two ways,
    // because a team's output and a person's pay are not the same kind of secret.

    // A TEAM's figures — stock, connections and activations — one document per team per
    // month, keyed on the team name.
    //
    // Readable by anyone signed in, on purpose. A team's output is not one person's
    // private business and the leaderboard is meant to be seen. Restricting it to "my
    // own team" would mean the stored team name and the employee's teamName agreeing
    // character for character, and those are two hand-typed fields that will not.
    match /perfTeams/{rowId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // COMMISSION — one document per person per month, and nobody else's business.
    //
    // The upload key is the employee number, because that is what the figures arrive
    // keyed on. The access key is the uid, resolved when the file is loaded and stored on
    // the row: a rule cannot normalise an employee number to compare it, and an employee
    // must not be able to read a colleague's pay. Same shape as timeLogs — a query
    // provably restricted to the caller's own uid is permitted, one asking for
    // everybody's is refused outright.
    //
    // A row whose employee number matched nobody has an empty uid and so is readable by
    // the admin alone, which is right: it belongs to no one yet.
    match /perfMonthly/{rowId} {
      allow get: if isAdmin() ||
        (isSignedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // FY — an incentive paid per person, per month, PER NETWORK, and nobody else's
    // business either.
    //
    // Its own collection rather than more fields on perfMonthly, for two reasons. The
    // network is part of the identity here and is not on a commission row, so the
    // document ids differ. And FY connections are not the team's connections: keeping
    // them apart is what stops an incentive's figures reaching the team percentages and
    // the leaderboard.
    //
    // Same access shape as perfMonthly: a query provably restricted to the caller's own
    // uid is permitted, one asking for everybody's is refused outright.
    match /perfFy/{rowId} {
      allow get: if isAdmin() ||
        (isSignedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Single settings document used by the app + Cloud Functions.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
