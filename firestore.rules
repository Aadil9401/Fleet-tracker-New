rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profiles. Accounts are created server-side by the createEmployee
    // Cloud Function (Admin SDK bypasses these rules), so no client "create".
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // Vehicles: everyone signed in can see fleet info, only admin edits it.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Time logs: an employee can create/update only their own log, and read
    // only their own; admin can read everything.
    match /timeLogs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Fuel logs: same pattern as time logs.
    match /fuelLogs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Single settings document used by the app + Cloud Functions.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
