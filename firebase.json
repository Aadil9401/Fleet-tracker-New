{
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        // Firebase defaults these to max-age=3600, so a deploy could take an hour
        // to reach anyone who had already opened the portal. The whole app is two
        // small files, so there's nothing to gain from caching them.
        // "**" rather than "**/*.html" so the bare "/" root is covered too — that
        // glob misses it, which is exactly how a stale page kept being served.
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  // Kept although nothing in the app uploads any more. A project set up after fuel
  // receipt uploads were removed has no bucket at all, and deploying storage rules to
  // it fails — so storage:rules is deliberately NOT in the deploy command in SETUP.md.
  // It stays here so a project that DOES have a bucket from an earlier setup can be
  // locked down with one "firebase deploy --only storage:rules"; storage.rules denies
  // everything. Withdrawing the file instead would leave the old permissive rules live.
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*-test.mjs"
      ]
    }
  ]
}
