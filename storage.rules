rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Fuel receipt photos: an employee can only upload into their own
    // folder; any signed-in user (i.e. admin too) can read.
    match /receipts/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
